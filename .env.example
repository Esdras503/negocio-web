# Clave de Google AI Studio para el Asistente Nexobyte.
# No uses el prefijo VITE_ ni expongas esta variable en el frontend.
GEMINI_API_KEY=

# Opcional. El valor predeterminado es gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash

# Opcional en local; recomendado en Vercel para compartir el rate limit
# entre instancias. Crea una base Upstash Redis REST y configura ambas claves.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
